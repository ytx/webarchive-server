{
  "name": "webarchive-server",
  "version": "0.1.0",
  "description": "Local server that stores SingleFile captures in a shared folder and lets you tag, annotate and search them",
  "type": "module",
  "bin": { "webarchive": "src/cli.js" },
  "files": ["src", "public"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/**/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "chokidar": "^5.0.0",
    "hono": "^4.13.5",
    "ulid": "^3.0.2"
  }
}
